ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
SECRET_KEY=replace-me-for-production
APP_HOST=127.0.0.1
APP_PORT=5050
APP_DEBUG=false
MAX_UPLOAD_MB=4096
ALLOW_SHARED_ELEVENLABS_KEY=false
REQUIRE_PAYMENT_FOR_SHARED_KEY=true
SHARED_KEY_RENDER_PRICE_CREDITS=1
ADMIN_BILLING_KEY=replace-me-admin-key
BILLING_TOKENS_FILE=workspace/billing_tokens.json
BILLING_AUDIT_FILE=workspace/billing_audit.jsonl

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SUCCESS_URL=http://127.0.0.1:5050/?payment=success
STRIPE_CANCEL_URL=http://127.0.0.1:5050/?payment=cancel
STRIPE_CURRENCY=usd
STRIPE_PRICE_1_CREDIT_CENTS=100

# Email recovery — leave blank to fully disable (users can still save their code manually)
# For Gmail: use your email + 16-char app password (not your regular password)
# 1. Enable 2FA on your Google account
# 2. Go to myaccount.google.com/apppasswords and create an app password for "Mail"
# 3. Use that 16-char password below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=VideoForge Studio <your@gmail.com>
APP_NAME=VideoForge Studio
APP_BASE_URL=http://127.0.0.1:5050
# Example production value: https://videoforge.knightlogics.com

# Admin testing: test email delivery with POST to /api/admin/test-email-recovery
# curl -X POST http://127.0.0.1:5050/api/admin/test-email-recovery \
#   -d admin_key=YOUR_ADMIN_BILLING_KEY \
#   -d test_email=your@gmail.com
